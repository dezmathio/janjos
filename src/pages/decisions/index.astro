---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DecisionList from '../../components/DecisionList.astro';
import { byDateDesc } from '../../utils/projects';

const decisions = (await getCollection('decisions')).sort(byDateDesc);
const projects = await getCollection('projects');
const projectTitles = Object.fromEntries(projects.map((project) => [project.id, project.data.title]));
---

<BaseLayout
  title="Decisions"
  description="Some thoughts on why I built things the way I did, or decided on different approaches along the way, intentionally vague, feel free to reach out for more specifics."
>
  <section class="max-w-3xl">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Decisions</h1>
    <p class="mt-4 text-xl text-mute">
      Some thoughts on why I built things the way I did, or decided on different
      approaches along the way, intentionally vague, feel free to reach out for
      more specifics.
    </p>
  </section>

  {
    decisions.length > 0 ? (
      <div class="mt-12">
        <DecisionList decisions={decisions} projectTitles={projectTitles} />
      </div>
    ) : (
      <p class="mt-12 text-xl text-mute">Nothing written down yet.</p>
    )
  }
</BaseLayout>
