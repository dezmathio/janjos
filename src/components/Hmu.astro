---
import { SITE } from '../utils/projects';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={[compact ? 'mt-3' : 'mt-10']}>
  <p class="text-base font-medium tracking-tight text-mute">hmu</p>
  <p class:list={[compact ? 'mt-1' : 'mt-3 text-xl sm:text-2xl']}>
    <a href={SITE.discord} rel="noreferrer" target="_blank">discord</a>
    <span class="mx-3 text-mute">·</span>
    <a href={SITE.twitter} rel="noreferrer" target="_blank">x</a>
    <span class="mx-3 text-mute">·</span>
    <a href={`mailto:${SITE.email}`}>email</a>
  </p>
</div>
