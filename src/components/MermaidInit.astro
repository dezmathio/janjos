---
// Only rendered on pages whose markdown has a ```mermaid block (see the
// `mermaid` prop on BaseLayout). Mermaid itself is a dynamic import, so even
// here nothing heavy downloads unless a diagram is actually on the page.
---

<script>
  async function renderDiagrams() {
    const hosts = new Set<Element>();
    for (const el of document.querySelectorAll('pre.mermaid, code.language-mermaid')) {
      const host = el.tagName === 'CODE' ? (el.closest('pre') ?? el) : el;
      hosts.add(host);
    }
    if (hosts.size === 0) return;

    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      theme: 'neutral',
      securityLevel: 'loose',
    });

    for (const host of hosts) {
      if (host.getAttribute('data-processed') === 'true') continue;
      const src = (host.textContent || '').trim();
      if (!src) continue;
      try {
        const id = 'mermaid-' + Math.random().toString(36).slice(2, 9);
        const { svg } = await mermaid.render(id, src);
        const wrap = document.createElement('div');
        wrap.className = 'mermaid-diagram';
        wrap.setAttribute('data-processed', 'true');
        wrap.innerHTML = svg;
        host.replaceWith(wrap);
      } catch (error) {
        console.error('mermaid render failed', error);
      }
    }
  }

  void renderDiagrams();
</script>
