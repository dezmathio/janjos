---
import StatusBadge from './StatusBadge.astro';
import { formatYear, type Project } from '../utils/projects';

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const pageHref = `${import.meta.env.BASE_URL}projects/${project.id}`;
const { title, subtitle, description, status, tags, repo, demo, notes } = project.data;

const primary = demo
  ? {
      href: demo,
      label: status === 'live' ? 'Visit' : 'View Demo',
      external: true,
    }
  : {
      href: pageHref,
      label: status === 'idea' ? 'Concept' : 'Open',
      external: false,
    };

const secondary = repo
  ? { href: repo, label: 'GitHub', external: true }
  : notes
    ? { href: notes, label: 'Notes', external: true }
    : null;
---

<article
  class:list={[
    'rounded-card border border-line bg-panel',
    compact ? 'px-5 py-4' : 'flex h-full flex-col p-7 sm:p-8',
  ]}
  data-project-card={!compact ? '' : undefined}
  data-kind={!compact ? project.data.kind : undefined}
>
  <div class="flex items-start justify-between gap-4">
    <h3 class:list={['font-semibold tracking-tight', compact ? 'text-lg' : 'text-2xl']}>
      <a href={pageHref} class="no-underline hover:text-mute">{title}</a>
    </h3>
    <StatusBadge status={status} />
  </div>
  <p class:list={['text-mute', compact ? 'mt-1 text-base' : 'mt-2 text-lg']}>{subtitle}</p>
  <p class="mt-2 text-sm text-mute">{formatYear(project.data.date)}</p>
  {
    !compact && (
      <>
        <p class="mt-4 text-base leading-relaxed text-mute">{description}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-full border border-line px-3 py-1 text-sm capitalize text-mute">
              {tag}
            </span>
          ))}
        </div>
        <div class="min-h-6 flex-1"></div>
        <div class="flex items-center justify-between gap-4 border-t border-line pt-4 text-base">
          <a
            href={primary.href}
            class="no-underline hover:text-mute"
            rel={primary.external ? 'noreferrer' : undefined}
            target={primary.external ? '_blank' : undefined}
          >
            {primary.label} →
          </a>
          {secondary && (
            <a
              href={secondary.href}
              class="text-mute no-underline hover:text-ink"
              rel="noreferrer"
              target="_blank"
            >
              {secondary.label}
            </a>
          )}
        </div>
      </>
    )
  }
</article>
