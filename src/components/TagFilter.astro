---
interface Props {
  filters: { value: string; label: string }[];
}

const { filters } = Astro.props;
---

<div class="flex flex-wrap gap-3" data-tag-filter>
  <button
    type="button"
    class="rounded-full border border-ink bg-ink px-5 py-2 text-base text-canvas"
    data-kind="all"
    aria-pressed="true"
  >
    All
  </button>
  {
    filters.map((filter) => (
      <button
        type="button"
        class="rounded-full border border-line px-5 py-2 text-base text-mute hover:text-ink"
        data-kind={filter.value}
        aria-pressed="false"
      >
        {filter.label}
      </button>
    ))
  }
</div>
<p class="mt-8 text-base text-mute" data-filter-empty hidden>
  Nothing in that category.
</p>

<script>
  const root = document.querySelector('[data-tag-filter]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  function cards(): HTMLElement[] {
    return [...document.querySelectorAll<HTMLElement>('[data-project-card]')];
  }

  function setPressed(active: string) {
    root?.querySelectorAll<HTMLButtonElement>('button[data-kind]').forEach((button) => {
      const on = button.dataset.kind === active;
      button.setAttribute('aria-pressed', String(on));
      button.classList.toggle('border-ink', on);
      button.classList.toggle('bg-ink', on);
      button.classList.toggle('text-canvas', on);
      button.classList.toggle('border-line', !on);
      button.classList.toggle('text-mute', !on);
    });
  }

  function apply(kind: string) {
    let visible = 0;
    for (const card of cards()) {
      const show = kind === 'all' || card.dataset.kind === kind;
      card.toggleAttribute('hidden', !show);
      if (show) visible += 1;
    }
    empty?.toggleAttribute('hidden', visible > 0);
    setPressed(kind);
  }

  root?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement | null)?.closest('button[data-kind]');
    if (!button || !(button instanceof HTMLButtonElement)) return;
    const kind = button.dataset.kind;
    if (!kind) return;
    apply(kind);
  });
</script>
