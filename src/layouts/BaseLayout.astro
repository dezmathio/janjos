---
import '@fontsource-variable/inter';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hmu from '../components/Hmu.astro';
import MatrixTrigger from '../components/MatrixTrigger.astro';
import MermaidInit from '../components/MermaidInit.astro';
import { SITE } from '../utils/projects';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Set when the page content has a ```mermaid block. */
  mermaid?: boolean;
}

const { title, description = SITE.description, noindex = false, mermaid = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.author}` : SITE.author;
const canonical = new URL(Astro.url.pathname, SITE.url);
const shareImage = new URL('about.png', SITE.url);

// jobTitle and linkedin stay out until they are filled in SITE.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  ...(SITE.jobTitle ? { jobTitle: SITE.jobTitle } : {}),
  sameAs: [SITE.github, SITE.twitter, SITE.chewsr, SITE.linkedin].filter(Boolean),
  knowsAbout: SITE.knowsAbout,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="Josiah Anjos in Sintra, Portugal" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('janjos-theme');
          var dark = stored ? stored === 'dark' : true;
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        } catch {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">
    <Header />
    <main class="mx-auto w-full max-w-6xl px-6 pb-24 pt-12 sm:px-10">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-6xl px-6 pb-12 text-base text-mute sm:px-10">
      <p>{SITE.author} · {SITE.domain}</p>
      <Hmu compact />
    </footer>
    {mermaid && <MermaidInit />}
    <MatrixTrigger />
    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://dezmathio.goatcounter.com/count"
          async
          src="https://gc.zgo.at/count.js"
        ></script>
      )
    }
  </body>
</html>
